# Copiez ce fichier en « .env » (server/.env) puis adaptez. Toutes les variables sont facultatives en développement.

PORT=4000
# OBLIGATOIRE en production (NODE_ENV=production) : longue chaîne aléatoire
JWT_SECRET=
# Adresse publique de l'application (liens envoyés par email / SMS)
APP_URL=https://mon-domaine.org
CORS_ORIGIN=

# --- Emails (facultatif) : réinitialisation de mot de passe, validations, etc. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jeunesse d'EDJAMBO <no-reply@mon-domaine.org>"

# --- SMS / WhatsApp (facultatif) ---
# console (défaut) : simulation, rien n'est envoyé  |  twilio  |  webhook (votre prestataire local)
SMS_PROVIDER=console

# Twilio : SMS et/ou WhatsApp (renseignez le ou les numéros expéditeurs disponibles)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=+1XXXXXXXXXX

# Webhook : l'application envoie un POST JSON {id, channel, to, body} à cette URL
# (réponse 2xx attendue, éventuellement {"id": "..."}) ; à brancher sur l'API SMS de votre opérateur
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Sauvegardes ---
BACKUP_KEEP=14
AUTO_BACKUP=1
